STYLE_SUFFIX_SKIP = {
    # Japonca / Romaji / Karaoke — cevirme
    'ROM', 'ROMAJI', 'ROMANIZED', 'ROMANIZATION',
    'JPN', 'JP', 'JAP', 'JAPANESE', 'JPNESE',
    'KANA', 'KANJI',
